{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: preparar configuracion",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/prepare_env.py"
      ],
      "windows": {
        "args": [
          "-d",
          "Ubuntu",
          "--exec",
          "python3",
          "scripts/prepare_env.py"
        ],
        "command": "wsl.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: levantar proyecto completo",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/start.py"
      ],
      "windows": {
        "args": [
          "-d",
          "Ubuntu",
          "--exec",
          "python3",
          "scripts/start.py"
        ],
        "command": "wsl.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Docker: comprobar servicio",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/check.py"
      ],
      "windows": {
        "args": [
          "-d",
          "Ubuntu",
          "--exec",
          "python3",
          "scripts/check.py"
        ],
        "command": "wsl.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: construir imagen",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "build"
      ],
      "windows": {
        "args": [
          "-d",
          "Ubuntu",
          "--exec",
          "docker",
          "compose",
          "build"
        ],
        "command": "wsl.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Docker: preparar configuracion"
    },
    {
      "label": "Docker: detener servicio",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "stop"
      ],
      "windows": {
        "args": [
          "-d",
          "Ubuntu",
          "--exec",
          "docker",
          "compose",
          "stop"
        ],
        "command": "wsl.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: ver ultimos logs",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "logs",
        "--tail",
        "50"
      ],
      "windows": {
        "args": [
          "-d",
          "Ubuntu",
          "--exec",
          "docker",
          "compose",
          "logs",
          "--tail",
          "50"
        ],
        "command": "wsl.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: levantar API y MariaDB",
      "dependsOn": "Docker: levantar proyecto completo",
      "problemMatcher": []
    },
    {
      "label": "Docker: crear y levantar servicio",
      "dependsOn": "Docker: levantar proyecto completo",
      "problemMatcher": []
    },
    {
      "label": "Docker: iniciar servicio existente",
      "dependsOn": "Docker: levantar proyecto completo",
      "problemMatcher": []
    }
  ]
}
