# Referencia de las variables; genera .env con python3 scripts/prepare_env.py.
MARIADB_DATABASE=artisa
MARIADB_USER=artisa_app
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
TELEMETRY_ENABLED=0
# URI usada por el contenedor ETL; el valor por defecto apunta al MongoDB de Compose.
MONGO_DOCKER_URI=mongodb://mongodb:27017
MONGO_DATABASE=gps_data
MONGO_COLLECTION=raw_gps
MONGO_TIMEOUT_SECONDS=10
TELEMETRY_BATCH_SIZE=5000
TELEMETRY_INTERVAL_SECONDS=300
ETL_AUTOSTART=0
ETL_MAX_BLOCKS_PER_CYCLE=1

